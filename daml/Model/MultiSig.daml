module Model.MultiSig where

import Model.Stablecoin
import DA.List (delete, unique)

-- Multi-signature wallet configuration
template MultiSigWallet
  with
    issuer: Party  -- Bank that issued the stablecoins
    walletId: Text
    signatories: [Party]  -- All parties who must sign
    requiredSignatures: Int  -- How many signatures needed (e.g., 2 of 3)
    holdingCid: ContractId StablecoinHolding  -- The locked stablecoin
  where
    signatory issuer
    observer signatories
    
    ensure requiredSignatures > 0 && 
           requiredSignatures <= length signatories &&
           unique signatories

    -- Propose a transfer from the multi-sig wallet
    choice ProposeMultiSigTransfer : ContractId MultiSigTransferProposal
      with
        proposer: Party
        recipient: Party
        amount: Decimal
      controller proposer
      do
        assertMsg "Proposer must be a signatory" (proposer `elem` signatories)
        
        holding <- fetch holdingCid
        assertMsg "Insufficient balance" (holding.amount >= amount)
        
        create MultiSigTransferProposal with
          wallet = this
          proposer = proposer
          recipient = recipient
          amount = amount
          approvers = [proposer]  -- Proposer automatically approves

    -- Add funds to the wallet (anyone can deposit)
    choice DepositToWallet : ContractId MultiSigWallet
      with depositCid: ContractId StablecoinHolding
      controller issuer
      do
        holding <- fetch holdingCid
        deposit <- fetch depositCid
        
        assertMsg "Currency mismatch" (holding.currency == deposit.currency)
        assertMsg "Issuer mismatch" (holding.issuer == deposit.issuer)
        
        -- Archive both holdings
        archive holdingCid
        archive depositCid
        
        -- Create merged holding
        newHolding <- create holding with
          amount = holding.amount + deposit.amount
        
        create this with holdingCid = newHolding

    -- Close the wallet and distribute funds (requires all signatories)
    choice CloseWallet : [ContractId StablecoinHolding]
      with distribution: [(Party, Decimal)]
      controller signatories
      do
        holding <- fetch holdingCid
        
        -- Verify distribution adds up
        let totalDistribution = sum (map snd distribution)
        assertMsg "Distribution must equal total balance" 
          (totalDistribution == holding.amount)
        
        -- Archive the holding
        archive holdingCid
        
        -- Create new holdings for each recipient
        forA distribution $ \(recipient, amt) -> do
          create holding with
            owner = recipient
            amount = amt

-- Multi-sig transfer proposal
template MultiSigTransferProposal
  with
    wallet: MultiSigWallet
    proposer: Party
    recipient: Party
    amount: Decimal
    approvers: [Party]  -- Parties who have approved so far
  where
    signatory wallet.issuer, proposer
    observer wallet.signatories, recipient
    
    ensure amount > 0.0

    -- Another signatory approves the transfer
    choice ApproveTransfer : Either (ContractId MultiSigTransferProposal) (ContractId StablecoinHolding, ContractId MultiSigWallet)
      with approver: Party
      controller approver
      do
        assertMsg "Approver must be a signatory" (approver `elem` wallet.signatories)
        assertMsg "Already approved" (approver `notElem` approvers)
        
        let newApprovers = approver :: approvers
            approvalCount = length newApprovers
        
        if approvalCount >= wallet.requiredSignatures
          then do
            -- Execute the transfer
            holding <- fetch wallet.holdingCid
            archive wallet.holdingCid
            
            -- Create holding for recipient
            recipientHolding <- create holding with
              owner = recipient
              amount = amount
            
            -- Create holding with remainder (if any)
            let remainder = holding.amount - amount
            
            if remainder > 0.0
              then do
                remainderHolding <- create holding with amount = remainder
                newWallet <- create wallet with holdingCid = remainderHolding
                return (Right (recipientHolding, newWallet))
              else do
                -- Wallet is empty, don't recreate it
                -- Create a dummy wallet with 0 balance for return type
                emptyHolding <- create holding with amount = 0.01
                emptyWallet <- create wallet with holdingCid = emptyHolding
                return (Right (recipientHolding, emptyWallet))
          else do
            -- Need more approvals
            newProposal <- create this with approvers = newApprovers
            return (Left newProposal)

    -- Signatory rejects the transfer
    choice RejectMultiSigTransfer : ()
      with rejector: Party
      controller rejector
      do
        assertMsg "Rejector must be a signatory" (rejector `elem` wallet.signatories)
        return ()

    -- Proposer cancels the transfer
    choice CancelMultiSigTransfer : ()
      controller proposer
      do
        return ()

-- Multi-sig wallet creation proposal
template MultiSigWalletProposal
  with
    issuer: Party
    walletId: Text
    signatories: [Party]
    requiredSignatures: Int
    initialHoldingCid: ContractId StablecoinHolding
  where
    signatory issuer
    observer signatories
    
    ensure requiredSignatures > 0 && 
           requiredSignatures <= length signatories &&
           unique signatories

    -- All signatories must agree to create the wallet
    choice ApproveWalletCreation : Either (ContractId MultiSigWalletProposal) (ContractId MultiSigWallet)
      with approver: Party
      controller approver
      do
        assertMsg "Approver must be a signatory" (approver `elem` signatories)
        
        -- For simplicity, auto-approve if issuer created it
        -- In production, you'd track individual approvals
        holding <- fetch initialHoldingCid
        
        wallet <- create MultiSigWallet with
          issuer = issuer
          walletId = walletId
          signatories = signatories
          requiredSignatures = requiredSignatures
          holdingCid = initialHoldingCid
        
        return (Right wallet)

    choice RejectWalletCreation : ContractId StablecoinHolding
      with rejector: Party
      controller rejector
      do
        assertMsg "Rejector must be a proposed signatory" (rejector `elem` signatories)
        -- Return the holding to the issuer
        holding <- fetch initialHoldingCid
        create holding