module Model.Stablecoin where

import DA.Date
import DA.Optional

-- Bank reserve tracking
template BankReserve
  with
    bank: Party
    currency: Text
    totalIssued: Decimal
    totalRedeemed: Decimal
  where
    signatory bank

    -- Issue new stablecoins
    choice IssueStablecoin : (ContractId StablecoinHolding, ContractId BankReserve)
      with
        owner: Party
        amount: Decimal
      controller bank
      do
        assertMsg "Amount must be positive" (amount > 0.0)
        now <- getTime
        create TransactionHistory with
          actor = bank
          transactionType = "issue"
          amount = amount
          currency = this.currency
          fromParty = None
          toParty = Some owner
          details = "Stablecoin issued to " <> show owner
          timestamp = now
        holding <- create StablecoinHolding with
          issuer = bank
          owner = owner
          amount = amount
          currency = this.currency
          frozen = False
        reserve <- create this with totalIssued = totalIssued + amount
        return (holding, reserve)

    -- Process redemption
    choice ProcessRedemption : ContractId BankReserve
      with
        amount: Decimal
        redeemer: Party
      controller bank
      do
        assertMsg "Amount must be positive" (amount > 0.0)
        assertMsg "Cannot redeem more than issued" (amount <= totalIssued - totalRedeemed)
        now <- getTime
        create TransactionHistory with
          actor = bank
          transactionType = "redeem"
          amount = amount
          currency = this.currency
          fromParty = Some redeemer
          toParty = None
          details = "Stablecoin redeemed from " <> show redeemer
          timestamp = now
        create this with totalRedeemed = totalRedeemed + amount

-- Issuance request (users request stablecoins from bank)
template IssuanceRequest
  with
    requester: Party
    bank: Party
    amount: Decimal
    currency: Text
    reason: Text
  where
    signatory requester
    observer bank

    choice ApproveIssuance : ContractId StablecoinHolding
      with reserveCid: ContractId BankReserve
      controller bank
      do
        (holding, _newReserve) <- exercise reserveCid IssueStablecoin with
          owner = requester
          amount = this.amount
        return holding

    choice RejectIssuance : ()
      controller bank
      do
        return ()

    choice CancelIssuanceRequest : ()
      controller requester
      do
        return ()

-- Redemption request (users return stablecoins to bank)
template RedemptionRequest
  with
    redeemer: Party
    bank: Party
    holdingCid: ContractId StablecoinHolding
    holding: StablecoinHolding
  where
    signatory redeemer
    observer bank

    choice ApproveRedemption : ContractId BankReserve
      with reserveCid: ContractId BankReserve
      controller bank
      do
        archive holdingCid
        exercise reserveCid ProcessRedemption with
          amount = holding.amount
          redeemer = this.redeemer

    choice RejectRedemption : ContractId StablecoinHolding
      controller bank
      do
        create holding

    choice CancelRedemptionRequest : ContractId StablecoinHolding
      controller redeemer
      do
        create holding

-- Transaction history record
template TransactionHistory
  with
    actor: Party
    transactionType: Text  -- "transfer", "split", "merge", "accept", "reject"
    amount: Decimal
    currency: Text
    fromParty: Optional Party
    toParty: Optional Party
    details: Text
    timestamp: Time
  where
    signatory actor

-- Core stablecoin holding
template StablecoinHolding
  with
    issuer: Party
    owner: Party
    amount: Decimal
    currency: Text
    frozen: Bool
  where
    signatory issuer
    observer owner
    ensure amount > 0.0

    -- Transfer to another party
    choice Transfer : ContractId TransferProposal
      with newOwner: Party
      controller owner
      do
        assertMsg "Account is frozen" (not frozen)
        now <- getTime
        create TransactionHistory with
          actor = owner
          transactionType = "transfer"
          amount = this.amount
          currency = this.currency
          fromParty = Some owner
          toParty = Some newOwner
          details = "Transfer proposal created"
          timestamp = now
        create TransferProposal with
          coin = this
          newOwner
          issuer

    -- Split holding into two parts
    choice Split : (ContractId StablecoinHolding, ContractId StablecoinHolding)
      with splitAmount: Decimal
      controller owner
      do
        assertMsg "Invalid split amount" (splitAmount > 0.0 && splitAmount < amount)
        assertMsg "Account is frozen" (not frozen)
        now <- getTime
        create TransactionHistory with
          actor = owner
          transactionType = "split"
          amount = this.amount
          currency = this.currency
          fromParty = None
          toParty = None
          details = "Split into " <> show splitAmount <> " and " <> show (amount - splitAmount)
          timestamp = now
        coin1 <- create this with amount = splitAmount
        coin2 <- create this with amount = amount - splitAmount
        return (coin1, coin2)

    -- Merge with another holding
    choice Merge : ContractId StablecoinHolding
      with otherCoinCid: ContractId StablecoinHolding
      controller owner
      do
        otherCoin <- fetch otherCoinCid
        assertMsg "Can only merge same currency" (otherCoin.currency == currency)
        assertMsg "Can only merge same issuer" (otherCoin.issuer == issuer)
        assertMsg "Account is frozen" (not frozen)
        now <- getTime
        create TransactionHistory with
          actor = owner
          transactionType = "merge"
          amount = this.amount + otherCoin.amount
          currency = this.currency
          fromParty = None
          toParty = None
          details = "Merged " <> show this.amount <> " and " <> show otherCoin.amount
          timestamp = now
        archive otherCoinCid
        create this with amount = amount + otherCoin.amount

    -- Request redemption (return to bank)
    choice RequestRedemption : ContractId RedemptionRequest
      controller owner
      do
        assertMsg "Account is frozen" (not frozen)
        create RedemptionRequest with
          redeemer = owner
          bank = issuer
          holdingCid = self
          holding = this

-- Transfer proposal (propose-accept pattern)
template TransferProposal
  with
    coin: StablecoinHolding
    newOwner: Party
    issuer: Party
  where
    signatory coin.owner, issuer  -- Both owner and issuer sign the proposal
    observer newOwner

    choice AcceptTransfer : ContractId StablecoinHolding
      controller newOwner
      do
        now <- getTime
        create TransactionHistory with
          actor = newOwner
          transactionType = "accept"
          amount = coin.amount
          currency = coin.currency
          fromParty = Some coin.owner
          toParty = Some newOwner
          details = "Transfer accepted"
          timestamp = now
        create coin with owner = newOwner

    choice RejectTransfer : ContractId StablecoinHolding
      controller newOwner
      do
        now <- getTime
        create TransactionHistory with
          actor = newOwner
          transactionType = "reject"
          amount = coin.amount
          currency = coin.currency
          fromParty = Some coin.owner
          toParty = Some newOwner
          details = "Transfer rejected"
          timestamp = now
        create coin

    choice CancelTransfer : ContractId StablecoinHolding
      controller coin.owner
      do
        create coin