module Init where

import Daml.Script
import qualified Model.Stablecoin as Stablecoin

init : Script ()
init = script do
  -- Get existing parties (or allocate if they don't exist)
  bank <- allocatePartyOn "Bank" (ParticipantName "participant0")
  alice <- allocatePartyOn "Alice" (ParticipantName "participant0")
  bob <- allocatePartyOn "Bob" (ParticipantName "participant0")

  -- Bank creates holdings (bank submits, alice is just owner)
  -- Note: With signatory issuer, owner - both must authorize
  bankAliceCoin1 <- submitMulti [bank, alice] [] do
    createCmd Stablecoin.StablecoinHolding with
      issuer = bank
      owner = alice
      amount = 1000.0
      currency = "USD"
      frozen = False

  bankAliceCoin2 <- submitMulti [bank, alice] [] do
    createCmd Stablecoin.StablecoinHolding with
      issuer = bank
      owner = alice
      amount = 500.0
      currency = "USD"
      frozen = False

  bankBobCoin <- submitMulti [bank, bob] [] do
    createCmd Stablecoin.StablecoinHolding with
      issuer = bank
      owner = bob
      amount = 2000.0
      currency = "USD"
      frozen = False

  debug ("Created holdings for Alice and Bob" : Text)
  
  return ()