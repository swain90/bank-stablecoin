module Init where

import Daml.Script
import qualified Model.Stablecoin as Stablecoin

init : Script ()
init = do
  -- Allocate parties
  bank <- allocatePartyWithHint "Bank" (PartyIdHint "Bank")
  alice <- allocatePartyWithHint "Alice" (PartyIdHint "Alice")
  bob <- allocatePartyWithHint "Bob" (PartyIdHint "Bob")

  -- Create users (so they can login with simple names)
  bankUserId <- validateUserId "Bank"
  aliceUserId <- validateUserId "Alice"
  bobUserId <- validateUserId "Bob"

  createUser (User bankUserId (Some bank)) [CanActAs bank]
  createUser (User aliceUserId (Some alice)) [CanActAs alice]
  createUser (User bobUserId (Some bob)) [CanActAs bob]

  -- Create bank reserve for USD
  reserveUSD <- submit bank $ createCmd Stablecoin.BankReserve with
    bank = bank
    currency = "USD"
    totalIssued = 0.0
    totalRedeemed = 0.0

  -- Issue stablecoins to Alice
  (aliceHolding1, reserve1) <- submit bank $ exerciseCmd reserveUSD Stablecoin.IssueStablecoin with
    owner = alice
    amount = 1000.0

  (aliceHolding2, reserve2) <- submit bank $ exerciseCmd reserve1 Stablecoin.IssueStablecoin with
    owner = alice
    amount = 500.0

  -- Issue stablecoins to Bob
  (bobHolding1, reserve3) <- submit bank $ exerciseCmd reserve2 Stablecoin.IssueStablecoin with
    owner = bob
    amount = 2000.0

  return ()