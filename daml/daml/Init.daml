module Init where

import Daml.Script
import qualified Model.Stablecoin as Stablecoin

init : Script ()
init = do
  -- Allocate parties
  bank <- allocatePartyWithHint "Bank" (PartyIdHint "Bank")
  alice <- allocatePartyWithHint "Alice" (PartyIdHint "Alice")
  bob <- allocatePartyWithHint "Bob" (PartyIdHint "Bob")

  -- Create users (so they can login with simple names)
  bankUserId <- validateUserId "Bank"
  aliceUserId <- validateUserId "Alice"
  bobUserId <- validateUserId "Bob"

  createUser (User bankUserId (Some bank)) [CanActAs bank]
  createUser (User aliceUserId (Some alice)) [CanActAs alice]
  createUser (User bobUserId (Some bob)) [CanActAs bob]

  -- Create holdings for Alice (only bank needs to sign now)
  submit bank $ createCmd Stablecoin.StablecoinHolding with
    issuer = bank
    owner = alice
    amount = 1000.0
    currency = "USD"
    frozen = False

  submit bank $ createCmd Stablecoin.StablecoinHolding with
    issuer = bank
    owner = alice
    amount = 500.0
    currency = "USD"
    frozen = False

  -- Create holdings for Bob (only bank needs to sign now)
  submit bank $ createCmd Stablecoin.StablecoinHolding with
    issuer = bank
    owner = bob
    amount = 2000.0
    currency = "USD"
    frozen = False

  return ()