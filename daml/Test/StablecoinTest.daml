module Test.StablecoinTest where

import Model.Stablecoin
import Model.Account
import Daml.Script
import DA.Date
import DA.Optional (fromOptional)

-- Setup test parties
setupParties = script do
  bank <- allocateParty "Bank"
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  auditor <- allocateParty "Auditor"
  return (bank, alice, bob, auditor)

-- Test: Complete issuance workflow
test_issuance_workflow = script do
  (bank, alice, bob, auditor) <- setupParties
  
  -- 1. Create reserve attestation
  let today = date 2025 Oct 1
  reserveCid <- submit auditor do
    createCmd ReserveAttestation with
      auditor
      issuer = bank
      reserveAmount = 1000000.0
      currency = "USD"
      attestationDate = today
      expiryDate = addDays today 30
  
  -- 2. Alice requests account
  requestCid <- submit alice do
    createCmd AccountRequest with
      bank
      user = alice
      accountId = "ALICE-001"
      kycDocuments = "passport-123"
  
  -- 3. Bank approves account
  accountCid <- submit bank do
    exerciseCmd requestCid ApproveAccount with
      kycExpiryDate = addDays today 365
      dailyLimit = 10000.0
      monthlyLimit = 50000.0
  
  -- 4. Bank issues stablecoin
  coinCid <- submit bank do
    exerciseCmd accountCid IssueStablecoin with
      amount = 1000.0
      currency = "USD"
      reserveAttestationCid = reserveCid
  
  -- 5. Verify holding
  coin <- query @StablecoinHolding alice
  assertMsg "Should have one coin" (length coin == 1)
  
  return coinCid

-- Test: Transfer workflow
test_transfer_workflow = script do
  (bank, alice, bob, auditor) <- setupParties
  
  -- Setup accounts and issue to Alice
  coinCid <- test_issuance_workflow
  
  -- Alice proposes transfer to Bob
  proposalCid <- submit alice do
    exerciseCmd coinCid Transfer with newOwner = bob
  
  -- Bob accepts
  bobCoinCid <- submit bob do
    exerciseCmd proposalCid AcceptTransfer
  
  -- Verify
  aliceCoins <- query @StablecoinHolding alice
  bobCoins <- query @StablecoinHolding bob
  
  assertMsg "Alice should have no coins" (length aliceCoins == 0)
  assertMsg "Bob should have one coin" (length bobCoins == 1)
  
  return bobCoinCid

-- Test: Split and merge
test_split_merge = script do
  (bank, alice, bob, auditor) <- setupParties
  coinCid <- test_issuance_workflow
  
  -- Split coin
  (coin1Cid, coin2Cid) <- submit alice do
    exerciseCmd coinCid Split with splitAmount = 400.0
  
  -- Query the split coins
  coin1Opt <- queryContractId @StablecoinHolding alice coin1Cid
  coin2Opt <- queryContractId @StablecoinHolding alice coin2Cid

  -- Handle the Optional type
  let coin1 = case coin1Opt of
        Some c -> c
        None -> error "Coin 1 not found"
  let coin2 = case coin2Opt of
        Some c -> c
        None -> error "Coin 2 not found"

  -- Assertions
  assertMsg "First coin should be 400" (coin1.amount == 400.0)
  assertMsg "Second coin should be 600" (coin2.amount == 600.0)
  
  -- Merge back
  mergedCid <- submit alice do
    exerciseCmd coin1Cid Merge with otherCoinCid = coin2Cid
  
  mergedOpt <- queryContractId @StablecoinHolding alice mergedCid
  let merged = case mergedOpt of
        Some c -> c
        None -> error "Merged coin not found"
  assertMsg "Merged coin should be 1000" (merged.amount == 1000.0)
  
  return ()